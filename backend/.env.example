# Copy this file to .env and fill in real local values.
# NEVER commit the real .env file.

# ---- Server ----
# Set production only for a real HTTPS deployment.
NODE_ENV=development
PORT=4000
# Set true only when the app is behind a trusted reverse proxy/load balancer.
# This controls req.ip/rate-limit client IP handling; never enable it on a directly exposed app.
TRUST_PROXY=false
# The exact origin the frontend is served from — must match precisely
# (scheme + host + port), since credentialed CORS requests reject a
# mismatch. The frontend (index.html/css/js) is a plain static site with
# no bundler/dev server of its own, so serve it with any static file
# server for local development, e.g. from the project root:
#   npx serve -l 5500 .
# or:
#   python3 -m http.server 5500
# then set this to whatever port you actually used. Comma-separated list
# supported if you need more than one origin.
#
# Loopback note: `localhost` and `127.0.0.1` are the same machine but
# DIFFERENT browser origins. If you list a loopback origin, the backend also
# allows its twin automatically (localhost <-> 127.0.0.1 on the same port), so
# opening the site via either spelling always works. Listing both explicitly
# is still fine. Non-loopback origins are never auto-expanded.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# ---- Database (local SQLite) ----
# The database is one local file relative to prisma/schema.prisma; no database
# server, credentials, or Docker service is required. Prisma 5.22 accepts the
# connection_limit query parameter for SQLite; limiting the client to one
# writer connection avoids avoidable lock contention in this single-process app.
DATABASE_URL="file:./dev.db?connection_limit=1"

# ---- Auth / sessions ----
# Used to sign the session-id cookie. Required. Generate a real value with:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value

# Name of the session cookie. Change only if it collides with something else.
SESSION_COOKIE_NAME=cyh_session

# How long a session lasts, in days. SESSION_TTL_DAYS is the default;
# SESSION_TTL_REMEMBER_DAYS is used when the client requests to be kept
# signed in (rememberMe: true on POST /api/auth/login).
SESSION_TTL_DAYS=7
SESSION_TTL_REMEMBER_DAYS=30

# ---- Redis (optional; current rate limiter is single-process) ----
# Sessions are stored in the local SQLite database for now via a SessionStore
# interface (see src/services/session.store.ts). REDIS_URL is reserved so a
# RedisSessionStore can be dropped in later without an env-shape change.
REDIS_URL=redis://localhost:6379

# ---- Email delivery / account recovery ----
# SMTP is required in production only while EMAIL_ENABLED=true. In development,
# leave unset until SMTP is configured — sends are then skipped and logged.
FRONTEND_URL=http://localhost:5500
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=security@your-domain.example
# Offline-first email toggle: false disables outbound email entirely (no
# transport created, no SMTP_* required — production boots fine without it).
EMAIL_ENABLED=true

# ---- Logging (file + console) ----
# Minimum level written to console AND the rotating file: debug|info|warn|error.
LOG_LEVEL=info
# Directory for rotated log files (app.log, app.log.1 ... app.log.5),
# resolved relative to the backend working directory.
LOG_DIR=logs
# Optional rotation tuning (defaults shown):
# LOG_FILE_MAX_BYTES=5242880
# LOG_FILE_MAX_FILES=5

# ---- Flags (challenges phase) ----
# Keys the HMAC-SHA256 used to hash correct flags and submitted attempts.
# Required. Generate a real value with:
#   openssl rand -base64 48
# Deliberately separate from SESSION_SECRET so rotating one never
# invalidates the other.
FLAG_HASH_SECRET=replace-with-a-different-long-random-value

# ---- Optional development/admin bootstrap ----
# Only used by `npm run prisma:seed`; never required by the running server.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password
